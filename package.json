{
  "name": "genai-learning-os",
  "version": "1.1.0",
  "description": "Learn AI through product decisions: 9 tracks, 19 strategy and math cases, 7 Case Academy lessons, 43 curated videos/courses, and 23 explained core papers.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "haimuhaimu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haimuhaimu/genai-learning-os.git"
  },
  "homepage": "https://haimuhaimu.github.io/genai-learning-os/",
  "bugs": {
    "url": "https://github.com/haimuhaimu/genai-learning-os/issues"
  },
  "keywords": [
    "generative-ai",
    "ai-education",
    "strategy-first",
    "product-strategy",
    "feedback-loops",
    "llm",
    "ai-agent",
    "rag",
    "model-distillation",
    "self-evolving-ai",
    "world-models",
    "interactive-learning"
  ],
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "node scripts/run-tests.mjs",
    "check:a11y": "node scripts/check-a11y-static.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:videos": "tsx --test src/resources/videoCatalog.test.mjs",
    "check:prebuild": "pnpm lint && pnpm test && pnpm check:a11y",
    "ci:check": "pnpm check:prebuild && pnpm build && pnpm check:bundle",
    "typecheck:case-example": "tsc -p examples/strategy-case/tsconfig.json",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.5",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.0.7"
  }
}
