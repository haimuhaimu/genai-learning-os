.k3-workshop .k3-run:hover:not(:disabled),.k3-workshop .k3-step-button:hover:not(:disabled){filter:brightness(1.08);transform:translateY(-1px)}
.k3-workshop .k3-run:disabled,.k3-workshop .k3-actions button:disabled{opacity:.5;cursor:not-allowed}
